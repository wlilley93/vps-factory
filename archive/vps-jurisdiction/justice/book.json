    "title": "Book Protection Act",
    "summary": "The generated statute book is law: changing it by hand requires a record entry saying why. Enacted when the kernel became a pinned dependency and [2026] VPS 2's scope, lean/Vps/, ceased to exist. VPS 2 is entrenched and therefore cannot be repointed, so this supplements it rather than superseding it.",
    "vectors": {
      "deny": {
        "pathsChanged": [
          "lean/Vjs/Book.lean"
        ],
        "recordsAdded": 0
      },
      "allow": {
        "pathsChanged": [
          "lean/Vjs/Book.lean",
          "record/0033.md"
        ],
        "recordsAdded": 1
      }
    }
  },
